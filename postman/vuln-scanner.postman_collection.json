  "item": [
    {
      "name": "Scan Text (Properties)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileType\": \"PROPERTIES\",\n  \"content\": \"spring-boot.version=3.2.0\\nlombok.version=1.18.28\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/scans/text",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "scans",
            "text"
          ]
        }
      }
    },
